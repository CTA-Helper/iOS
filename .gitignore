.DS_Store

# Xcode
build/
DerivedData/
**/xcuserdata/
*.xcuserstate

# Swift Package Manager
.build/
.swiftpm/

# SwiftLint / swift-format
.swiftlint/RemoteConfigCache
.swift-format

# Signing keys & secrets — never commit
*.p8
*.p12
*.key

# fastlane outputs
fastlane/screenshots/
fastlane/test_output/
fastlane/report.xml
fastlane/Preview.html

.claude/settings.local.json
.mcp.json

# fastlane secrets — fastlane loads fastlane/.env automatically
fastlane/.env
fastlane/.env.*
!fastlane/.env.example
