git_url("git@github.com:RISCfuture/certificates.git")
storage_mode("git")

# The certificates repository has one branch, and it is not the one match reaches for: its
# git_branch defaults to "master", and a branch that does not exist is not an error to match —
# it starts an empty one, decrypts nothing, and reports no code signing identity for every type
# asked of it, certificates it holds notwithstanding.
git_branch("main")

type("appstore")
team_id("2NFSK2WB24")

# The App Store profile is stored alongside the certificate, because `exportArchive` cannot obtain
# one on its own: cloud signing is refused for distribution. The archive still signs automatically —
# the project stays on automatic signing for local development, and only the export consumes this
# profile, which build_app wires into its export options from match's mapping.
app_identifier(["codes.tim.CTA-Helper"])
